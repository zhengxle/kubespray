<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>集群测试报告</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 40px; background-color: #f4f6f9; }
        .report-card { background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); max-width: 1000px; margin: 0 auto; }
        h2 { margin-top: 0; color: #1a1a1a; font-size: 22px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; border-radius: 8px; overflow: hidden; }
        th { background-color: #e9ecef; color: #495057; text-align: center; padding: 12px; font-size: 14px; font-weight: 600; }
        td { padding: 12px; text-align: center; font-weight: bold; border-bottom: 1px solid #eef0f3; font-size: 14px; }
        .ip-col { text-align: left; color: #1b66c9; font-weight: bold; }
        .status-pass { background-color: #28a745; color: #ffffff; }
        .status-fail { background-color: #dc3545; color: #ffffff; }
        .status-skip { background-color: #ffc107; color: #212529; }
        .status-na   { background-color: #6c757d; color: #ffffff; }
    </style>
</head>
<body>

<div class="report-card">
    <h2>集群测试报告</h2>
    <table>
        <thead>
            <tr>
                <th style="text-align: left; width: 20%;">服务器</th>
                {# 从第一个节点的 check_results 动态提取所有测试项列名 #}
                {% set first_host = play_hosts[0] %}
                {% set test_items = hostvars[first_host].check_results | default({}) %}
                {% for test_name in test_items.keys() %}
                <th>{{ test_name }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for host in play_hosts %}
            {% set res = hostvars[host].check_results | default({}) %}
            <tr>
                <td class="ip-col">{{ hostvars[host].ansible_host | default(host) }}</td>
                {# 动态渲染当前主机每个测试项的结果 #}
                {% for test_name in test_items.keys() %}
                    {% set status = res.get(test_name, 'N/A') %}
                    {% if status == 'PASS' %}
                        <td class="status-pass">PASS</td>
                    {% elif status == 'SKIP' %}
                        <td class="status-skip">SKIP</td>
                    {% elif status == 'FAIL' %}
                        <td class="status-fail">FAIL</td>
                    {% else %}
                        <td class="status-na">{{ status }}</td>
                    {% endif %}
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

</body>
</html>
